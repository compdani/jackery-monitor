# Preview build; Dockerfile remains the production Python image until live cutover.
FROM node:22-bookworm-slim AS ui
WORKDIR /src/ui
COPY ui/package*.json ./
RUN npm ci
COPY ui/ ./
RUN npm run check && npm run build

FROM golang:1.26.5-bookworm AS go
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY models.go models.json ./
COPY cmd/ cmd/
COPY internal/ internal/
COPY pb_migrations/ pb_migrations/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/jackery ./cmd/jackery

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl smbclient rsync openssh-client tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home jackery \
    && mkdir -p /data && chown jackery:jackery /data
WORKDIR /app
COPY --from=go /out/jackery /usr/local/bin/jackery
COPY --from=ui /src/pb_public/ /app/pb_public/
ENV JACKERY_DATA_DIR=/data PORT=8124
USER jackery
EXPOSE 8124
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 CMD curl --fail --silent "http://127.0.0.1:${PORT}/api/health" > /dev/null || exit 1
CMD ["sh", "-c", "exec jackery serve --http=0.0.0.0:${PORT}"]
