# Copy to .env.local (gitignored) to point the Kit dev server's /api + /ws
# proxy at a real Solar Pow Monitor instance while developing the UI.
#
#   cp .env.example .env.local
#   # edit JACKERY_DEV_API, then:
#   npm run dev
#
# Or one-shot without a file:
#   JACKERY_DEV_API=https://your-nas.example.com npm run dev
#
# Default when unset: http://127.0.0.1:8000
JACKERY_DEV_API=http://127.0.0.1:8000
